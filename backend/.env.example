FMP_API_KEY=your_fmp_api_key_here

# Custom LLM endpoint (OpenAI-compatible)
LLM_URL=https://llm.example.com/v1
API_KEY=your_api_key_here
MODEL=gpt-oss-20b

# Database (SQLite by default — no setup needed)
# For PostgreSQL: postgresql://user:password@localhost/finora
DATABASE_URL=sqlite:///./finora.db

# Cron schedule (default: Sunday 20:00)
CRON_DAY_OF_WEEK=sun
CRON_HOUR=20
CRON_MINUTE=0

# API keys allowed to trigger a screen run (POST /trigger) — comma-separated for multiple
TRIGGER_API_KEY=["key-one","key-two"]

# Optional: webhook URL for Slack/Discord/custom notification
WEBHOOK_URL=
